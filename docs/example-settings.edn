;; Every setting gw/start takes, with an example and what it is.
;; Generated from groundwork.settings; don't edit by hand.
{;; Where the app runs
 :environment :development

 ;; The database
 :db
 {;; The database server's address
  :host "localhost"

  ;; Its port
  :port 5432

  ;; The database's name
  :database "app"

  ;; The user Groundwork connects as
  :user "app"

  ;; Its password, or nil for none
  :password nil

  ;; Connections per server, a fixed number
  :pool-size 10

  ;; Postgres cancels a statement that runs longer; :none for no limit
  :statement-timeout-ms 30000

  ;; The session's time zone: how times without an offset are read
  :time-zone "UTC"

  ;; Runs first in every with-transaction: (fn [tx] …) (optional)
  :on-transaction app.db/on-transaction

  ;; After every query: (fn [{:keys [file sql ms error]}] …) (optional)
  :on-query app.db/on-query}

 ;; The schema's changes, run at start
 :migrations
 {;; The file development writes the whole schema to, or nil for none
  :schema-snapshot "schema.sql"}

 ;; The page shell every screen loads into
 :page
 {;; The page's language
  :lang "en"

  ;; The browser tab's title
  :title "Acme Orders"

  ;; A one-sentence summary for search results and link previews, or nil
  :description "Orders and invoices for small shops"

  ;; The tab's icon
  :icon "/icon.svg"

  ;; The CSS files every page loads
  :stylesheets ["/app.css"]

  ;; Extra tags at the end of <head>, as HTML text
  :head []}

 ;; The app's browser code and its build
 :browser
 {;; The browser build's id
  :build :app

  ;; The app's browser entry: the function that calls groundwork.browser/start!
  :entry app.browser/start

  ;; Where the compiled files go, a folder whose public/ is served
  :output-dir "resources/public/js"

  ;; Where the browser fetches them
  :asset-path "/js"

  ;; In development, whether the start also watches the build
  :watch? true

  ;; The build's modules, for an app with more than one: module → {:init-fn … or :entries […], :depends-on #{…}}. Without it there is one, :main, starting :entry (optional)
  :modules {:base {:init-fn app.browser/start},
            :admin {:entries [app.admin.view], :depends-on #{:base}}}

  ;; Whether modules no page names load on demand (shadow-cljs's module loader) (optional)
  :loader? true

  ;; Extra shadow-cljs build options, merged over Groundwork's: JS resolution, build hooks, compiler options (optional)
  :options
  {}}

 ;; The app's stylesheets, named by its namespaces and bundled per browser module; nil or left out when the app brings its own through :page :stylesheets
 :styles
 {;; Where the browser code and its stylesheets are: every .css under them is named by a namespace's {:css […]}, and in development a saved one rebuilds the bundles
  :sources ["src"]

  ;; Where the bundles and their manifest go, a folder whose public/ is served
  :output-dir "resources/public/css"

  ;; Where the browser fetches them
  :asset-path "/css"

  ;; The browsers the stylesheets are built for, a browserslist query: lightningcss flattens nesting and writes vendor prefixes for them, in development and release; every build stops on a query browserslist doesn't know or that names no browser
  :targets "safari >= 16.4, chrome >= 119"}

 ;; Requests: the app's routes, limits, hooks, languages
 :web
 {;; The app's routes, reitit data; each route's data is checked like below
  :routes [["/" {:get groundwork.web/page, :access :public}]
           ["/orders/:order-id"
            {:get groundwork.web/page,
             :access {:action :orders/see, :record [:order :order-id]}}]
           ["/webhooks/payments"
            {:post app.payments/webhook, :server-to-server true}]]

  ;; The largest request body any route accepts (a route may allow more)
  :max-body-bytes 1048576

  ;; Sources the app adds to the strict policy, per directive
  :content-security-policy {:img-src ["https://cdn.example"]}

  ;; Where a signed-out browser asking for a page is sent
  :login-path "/login"

  ;; After every answer, for logs and metrics, or nil
  :on-request app.log/request

  ;; An exception no handler caught, or nil
  :on-error app.log/error

  ;; Which addresses are trusted proxies, and the headers believed from them
  :proxies
  {;; Trusted proxy addresses or ranges
   :trusted ["10.0.0.0/8" "::1"]

   ;; The header holding the visitor's address, or nil
   :client-ip-header "cf-connecting-ip"

   ;; The header holding a request id to keep, or nil
   :request-id-header "x-request-id"}

  ;; The languages the app speaks, or nil for one
  :languages {:supported ["en" "de"], :default "en", :cookie "lang"}

  ;; Lets automated tests sign in, given the secret; nil to switch off, never in production
  :test-sign-in nil

  ;; Evaluates code from outside, given the secret; nil to switch off, never in production
  :eval-bridge nil

  ;; Files whose names match (a regular expression, as text) are cached a year; nil for none
  :hashed-files "(?i)\\.[0-9a-f]{8,}\\."

  ;; Text-like answers at least this big go gzipped; nil for none
  :gzip-min-bytes 1024

  ;; What a browser gets at an address no route knows: nil (or left out) for the page shell, whose browser routing may know it; or a handler, for an app whose pages are all routes (its own 404) (optional)
  :unknown-page app.pages/not-found}

 ;; The web server
 :server
 {;; The address to listen on
  :ip "0.0.0.0"

  ;; The port to listen on; 0 picks a free one
  :port 8080}

 ;; Who is signed in
 :sessions
 {;; The session cookie's name
  :cookie-name "acme_session"

  ;; A signed-in session's lifetime
  :max-age-days 30

  ;; A visitor's session ends after this long unseen
  :visitor-hours 24

  ;; Cookies only over https; false only for plain-http development
  :secure? true

  ;; Where the app is served from; a changing request must come from here
  :origin "https://app.acme.example"}

 ;; Who may do what, where: the permission description
 :permissions
 {;; The kinds of scope: where data belongs and people are members
  :scopes {:shop
           {:actions #:orders{:see #{:read}, :edit #{:read :update}},
            :roles {"Manager" #{:orders/see :orders/edit}},
            :parent nil}}

  ;; The kinds of record, and whose row each column names
  :records {:order
            {:table :orders,
             :id :order/id,
             :whose #:order{:shop-id :shop, :customer-id :person}}}

  ;; Who may do what: one list of sentences, read at start (see groundwork.permissions.rules)
  :rules [{:allow :orders/see, :on :order, :to [:member :order/shop-id]}
          {:deny :money/move, :session :impersonated}]}

 ;; How often a caller may ask
 :limits
 {;; What a public endpoint or route without its own limit gets, per caller each minute, or nil
  :public {:reads-per-minute 600, :writes-per-minute 60}

  ;; Every caller turned away: (fn [{:keys [id limit caller]}] …), or nil
  :on-limit app.log/limited}

 ;; Background jobs and schedules, or nil for none
 :jobs
 {;; The app's job kinds, gathered from its areas
  :kinds [app.mail/jobs]

  ;; Jobs run on a clock, cron lines in UTC
  :schedules [{:job :app.reminders/send, :params {}, :cron "0 18 * * *"}]

  ;; Jobs running at once on this server
  :workers 4

  ;; How often to look for due jobs when nothing wakes the workers
  :poll-ms 5000

  ;; Whether this server runs jobs; false on previews, where they wait
  :on? true}

 ;; The endpoints and how they're asked
 :parquery
 {;; The app's endpoint maps, gathered from its areas
  :endpoints [app.jobs/endpoints app.orders/endpoints]

  ;; The most asks one request may carry
  :max-asks 50

  ;; The most asks running at once across the server; keep it below the pool size
  :max-running 16

  ;; Whose token a tool calls with: (fn [token] person-id-or-nil), or nil
  :bearer app.tools/token->person

  ;; After every ask over HTTP: (fn [{:keys [endpoint status ms person request-id]}] …), or nil
  :on-answer app.metrics/on-answer

  ;; How the tables outside the permission description ring
  :bells
  {;; Tables every watcher of them hears about: table → the reason. A global table is one whose rows belong to nobody, or whose every row is read by everyone; a table whose rows belong to a scope goes in the permission description
   :global {:countries "reference data only the platform's staff change"}

   ;; Tables only their person hears about: table → person column
   :personal {:notifications :notification/person-id}

   ;; Tables that ring nothing, on purpose: table → the reason. Every table of the app says how it rings, here or in the permission description, or the start refuses; :groundwork/every-other-table covers the rest of a database the app shares with something else (optional)
   :silent {:import_log "written once by the nightly import, shown nowhere"}}}}
