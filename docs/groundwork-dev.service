# The development start of a Groundwork app as a systemd user service:
# the app, the browser build's watcher, an nREPL (with clojure-mcp pointed at
# it) and the log, running without a terminal and restarting if it crashes.
#
#   cp docs/groundwork-dev.service ~/.config/systemd/user/my-app-dev.service
#   (edit WorkingDirectory, the settings var and the port)
#   systemctl --user daemon-reload
#   systemctl --user enable --now my-app-dev
#   journalctl --user -u my-app-dev -f        # or the app's .groundwork/dev.log
#
# systemctl --user stop sends SIGTERM: the app, the watcher and the nREPL stop
# cleanly (groundwork.repl.dev/serve). The nREPL keeps its port, so .mcp.json and
# an editor's connection stay the same from start to start.

[Unit]
Description=my-app in development (Groundwork)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Work/apps/my-app
# clojure and java from where the toolchain put them; a user service has a short PATH
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=clojure -X:dev groundwork.repl.dev/serve :settings app.settings/dev :nrepl-port 7888
StandardInput=null
Restart=on-failure
RestartSec=5
# the JVM answers SIGTERM with 143 after its shutdown hooks ran: a clean stop
SuccessExitStatus=143
TimeoutStopSec=45

[Install]
WantedBy=default.target
