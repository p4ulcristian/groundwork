;; groundwork: one tree. source-code/groundwork/server/<library>/ runs on the server
;; (groundwork.server.*), source-code/groundwork/browser/<library>/ in the browser
;; (groundwork.browser.*). Which library may use which is libraries.edn, checked by
;; test-code/groundwork/libraries_test.clj.
{:paths ["source-code"]

 :deps
 {org.clojure/clojure               {:mvn/version "1.12.6"}
  ;; wire: its own library, github.com/p4ulcristian/wire; main makes the app's
  ;; one wire from the :wire settings and passes it to every library
  io.github.p4ulcristian/wire       {:git/tag "v0.2.1" :git/sha "900a84d"}
  ;; the settings and the browser start's options, checked by their shapes
  metosin/malli                     {:mvn/version "0.20.3"}
  ;; logbook: the app's log, its own library, github.com/p4ulcristian/logbook;
  ;; main makes one logbook from the :logbook settings and passes its log to every library
  io.github.p4ulcristian/logbook    {:git/tag "v0.1.2" :git/sha "823f8fc"}
  ;; cellar: Postgres, its own library, github.com/p4ulcristian/cellar
  ;; on its tidy-up branch, not released: a table map writes out :uniques and :checks, a
  ;; reference what it does, an index as a map; migrate! takes {:tables :extensions :functions
  ;; :views}, a function a file or one a library made, and drops a function in the tables'
  ;; folders that nothing declared makes; a column's type changed by a change; run-after-commit!;
  ;; run-in-transaction! takes the caller's :log, where an after-commit failure is written
  io.github.p4ulcristian/cellar     {:git/tag "v0.4.6" :git/sha "4396e6b"}
  ;; backroom: background jobs on Postgres, its own library, github.com/p4ulcristian/backroom
  ;; on its tidy-up branch, not released: a job kind names its system actor, and its one
  ;; transaction (the work and the done-mark) runs as it, opened by doorman's run-as-system!,
  ;; carrying the job's log; its tables in cellar's tidy-up shapes
  io.github.p4ulcristian/backroom   {:git/tag "v0.5.6" :git/sha "43acc7c"}
  ;; bridge: named messages over http, sse and ws, a handler's steps, the routes;
  ;; both sides, its own library, github.com/p4ulcristian/bridge (it brings
  ;; Jetty 12 through rj9a, reitit-ring and reitit-frontend)
  ;; on its tidy-up branch, not released: a message may come with no request (the REPL's);
  ;; answer-message's limiter is make-message-limiter's (or :no-rate-limits); a refusal is a
  ;; named reason, declared on its handler; answer-message counts on the app's meter;
  ;; send-message! takes :keep-alive?; an sse line tells its break (:on-break); go-to-page!
  ;; takes :push or :replace; :may-leave? is asked with the move, finish-move! finishes it
  io.github.p4ulcristian/bridge   {:git/tag "v0.7.8" :git/sha "90dd8fa"}
  ;; doorman: who is asking and what may they do, sessions and access, its own
  ;; library, github.com/p4ulcristian/doorman (it brings malli and test.check)
  ;; on its tidy-up branch, not released: a handler says where it acts; tokens; roles have
  ;; ids; doorman's own reasons put on every handler; the leak test takes the app's meter;
  ;; its tables in cellar's tidy-up shapes, its own functions declared by their files, those
  ;; made from the sentences handed to the app (make-access-functions); every transaction it
  ;; opens carries its caller's log (the check's, the message's)
  io.github.p4ulcristian/doorman    {:git/tag "v0.7.10" :git/sha "8d59580"}
  ;; doorbell: a change to a table rings every open screen, which asks again;
  ;; both sides, its own library, github.com/p4ulcristian/doorbell
  ;; on its tidy-up branch, not released: an ask with no answer is bridge's :bridge/no-answer;
  ;; doorbell.tell() declared to cellar by its file (function-files)
  io.github.p4ulcristian/doorbell   {:git/tag "v0.5.9" :git/sha "60cab75"}
  ;; parlor: the browser's screens over doorbell's question store, in re-frame,
  ;; drawn with Reagent (it brings re-frame and Reagent; react and react-dom
  ;; are package.json's); the browser's side only, its own library,
  ;; github.com/p4ulcristian/parlor
  ;; on its tidy-up branch, not released: mount-root! refuses before :parlor/start; tr only
  ;; in views; :on-signed-out with the page; the unsaved-changes guard takes a key and
  ;; :ask-with; every send writes out {:once-key :keep-alive?}; a move writes :push or
  ;; :replace; find-answer reads a held answer in an event handler
  io.github.p4ulcristian/parlor     {:git/tag "v0.8.4" :git/sha "3e89966"}
  ;; dictionary: which language a request, a page and an address are in; both
  ;; sides, its own library, github.com/p4ulcristian/dictionary (parlor brings
  ;; it to the browser too)
  ;; on its tidy-up branch, not released: with-language refuses a nil language or bad texts;
  ;; check-texts-of-reasons; tr is the one text call on the server
  io.github.p4ulcristian/dictionary {:git/tag "v0.4.2" :git/sha "a3aa64d"}
  ;; meter: the app's metrics, its own library, github.com/p4ulcristian/meter;
  ;; main makes one meter from the :meter settings and passes it to every
  ;; library that counts, and serves its text at the :metrics route
  io.github.p4ulcristian/meter      {:git/tag "v0.1.4" :git/sha "bf81c46"}
  ;; attic: the app's files, its own library, github.com/p4ulcristian/attic;
  ;; main makes one attic from the :attic :storage settings, migrates its files
  ;; table and serves its upload route at :attic :upload :path
  ;; on its tidy-up branch, not released: its files table in cellar's tidy-up shapes;
  ;; delete-file-after-commit!, by cellar's run-after-commit!
  io.github.p4ulcristian/attic     {:git/tag "v0.1.4" :git/sha "ee84b16"}
  ;; postbox: the app's email, its own library, github.com/p4ulcristian/postbox;
  ;; main makes one postbox from the :postbox :sending settings, runs its
  ;; background job kind, migrates its emails table and serves its webhooks
  ;; on its tidy-up branch, not released: the sending job runs as the :system-actor the app names;
  ;; its emails table in cellar's tidy-up shapes
  io.github.p4ulcristian/postbox   {:git/tag "v0.1.4" :git/sha "4a12d5b"}
  ;; safe: the settings and their secrets, its own library, github.com/p4ulcristian/safe;
  ;; an app loads its settings with safe/load, every secret in them wrapped (it prints
  ;; as its name); groundwork compares the :errors token with safe/equal?
  io.github.p4ulcristian/safe       {:git/tag "v0.1.1" :git/sha "72d0dbb"}
  ;; study: the REPL into the running app, by the :study settings, with
  ;; groundwork's tools in study.tools; its own library, github.com/p4ulcristian/study
  io.github.p4ulcristian/study      {:git/tag "v0.1.2" :git/sha "94df041"}}

 :aliases
 {;; every test:                  clojure -X:test
  ;; one library's tests:         clojure -X:test :dirs '["test-code/groundwork/server/main"]'
  :test {:extra-paths ["test-code"]
         :extra-deps  {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                       ;; the browser build's test compiles every browser library, and the
                       ;; end-to-end test release-builds its sample app
                       io.github.p4ulcristian/browser-build {:git/tag "v0.4.4" :git/sha "f69ed00"}}
         :exec-fn     cognitect.test-runner.api/test
         :exec-args   {:dirs ["test-code"]}}

  ;; the browser build: browser-build, its own library, github.com/p4ulcristian/browser-build
  ;; (it brings shadow-cljs); on its tidy-up branch, not released: a module names its
  ;; :start, a build its :silenced-warnings, :css (its :targets; the lightningcss program is
  ;; browser-build's pin) and :lightningcss-download-timeout-ms, a watch its :preloads.
  ;; Only to build, never in production: it is in these
  ;; aliases, not in :deps. Development: add :browser-build to the REPL or the dev start
  ;; (its watch options are the :browser-build {:watch …} settings).
  ;; The deploy:  clojure -X:browser-release (an app writes its own :entry and :files-folder)
  :browser-build   {:extra-deps {io.github.p4ulcristian/browser-build {:git/tag "v0.4.4" :git/sha "f69ed00"}}}
  :browser-release {:extra-deps {io.github.p4ulcristian/browser-build {:git/tag "v0.4.4" :git/sha "f69ed00"}}
                    :exec-fn    browser-build.api/build-for-release!
                    :exec-args  {:entry              app.browser.main/start!
                                 :modules            {}               ; the app's :browser-modules, loaded on demand, each with its :start
                                 :files-folder       "target/public"
                                 :cache-folder       ".shadow-cljs"   ; shadow-cljs's cache
                                 :compile-threads    4
                                 :output-feature-set :es2020          ; what the browsers must understand
                                 :resolve            {}
                                 :closure-defines    {}
                                 :warnings-as-errors #{}
                                 :silenced-warnings  #{}              ; compiler warnings not shown
                                 :css                nil              ; no CSS step: each bundle as its files are written; or {:targets "chrome >= 119, safari >= 16.4"}
                                 :lightningcss-download-timeout-ms 60000   ; browser-build's pinned lightningcss, downloaded with :css
                                 :source-maps?       false            ; a .map beside each file, readable by anyone
                                 :gzip-level         9}}}}            ; the .gz copies, 1 (fast) to 9 (smallest)
