{:paths ["src" "resources"]

 :deps
 {org.clojure/clojure               {:mvn/version "1.12.6"}
  com.github.seancorfield/next.jdbc {:mvn/version "1.3.1118"}
  org.postgresql/postgresql         {:mvn/version "42.7.13"}
  com.zaxxer/HikariCP               {:mvn/version "7.1.0"}
  metosin/jsonista                  {:mvn/version "0.3.14"}
  integrant/integrant               {:mvn/version "1.0.1"}
  http-kit/http-kit                 {:mvn/version "2.8.1"}
  metosin/reitit-ring               {:mvn/version "0.11.0"}
  ring/ring-core                    {:mvn/version "1.15.5"}
  metosin/malli                     {:mvn/version "0.20.3"}}

 :aliases
 {;; clojure -X:test   (local database groundwork_test, see test/groundwork/postgres_test.clj)
  :test {:extra-paths ["test"]
         :extra-deps  {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                       ;; HikariCP logs through SLF4J; the app picks a logger, tests pick none
                       org.slf4j/slf4j-nop {:mvn/version "2.0.20"}}
         :exec-fn     cognitect.test-runner.api/test}}}
