;; Groundwork: server-code/ holds the libraries that run on the server (groundwork.server.*),
;; browser-code/ the ones that run in the browser (groundwork.browser.*); each has its deps.edn.
;; One library alone, from git: {:git/url … :git/sha … :deps/root "server-code/database"}
{:deps
 {io.github.p4ulcristian/groundwork-server-main {:local/root "server-code/main"}}

 :aliases
 {;; the workbench: every library at once, one REPL
  :dev  {:extra-deps {io.github.p4ulcristian/groundwork-server-wire {:local/root "server-code/wire"}
                      io.github.p4ulcristian/groundwork-server-steps {:local/root "server-code/steps"}
                      io.github.p4ulcristian/groundwork-server-database {:local/root "server-code/database"}
                      io.github.p4ulcristian/groundwork-server-transport {:local/root "server-code/transport"}
                      io.github.p4ulcristian/groundwork-server-sessions {:local/root "server-code/sessions"}
                      io.github.p4ulcristian/groundwork-server-access {:local/root "server-code/access"}
                      io.github.p4ulcristian/groundwork-server-background-chores {:local/root "server-code/background-chores"}
                      io.github.p4ulcristian/groundwork-server-main {:local/root "server-code/main"}
                      io.github.p4ulcristian/groundwork-browser-wire {:local/root "browser-code/wire"}
                      io.github.p4ulcristian/groundwork-browser-transport {:local/root "browser-code/transport"}
                      io.github.p4ulcristian/groundwork-browser-main {:local/root "browser-code/main"}}}

  ;; every library's tests together:   clojure -X:test
  :test {:extra-paths ["server-code/wire/test-code" "server-code/steps/test-code" "server-code/database/test-code" "server-code/transport/test-code" "server-code/sessions/test-code" "server-code/access/test-code" "server-code/background-chores/test-code" "server-code/main/test-code"]
         :extra-deps  {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                       ;; HikariCP logs through SLF4J; tests pick no logger
                       org.slf4j/slf4j-nop {:mvn/version "2.0.17"}}
         :exec-fn     cognitect.test-runner.api/test
         :exec-args   {:dirs ["server-code/wire/test-code" "server-code/steps/test-code" "server-code/database/test-code" "server-code/transport/test-code" "server-code/sessions/test-code" "server-code/access/test-code" "server-code/background-chores/test-code" "server-code/main/test-code"]}}

  ;; the browser half's tests:   npx shadow-cljs compile test
  :cljs {:extra-paths ["browser-code/wire/test-code"]
         :extra-deps  {thheller/shadow-cljs {:mvn/version "3.5.7"}
                       io.github.p4ulcristian/groundwork-browser-main {:local/root "browser-code/main"}}}}}
