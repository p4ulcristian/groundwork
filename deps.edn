{:paths ["src" "resources"]

 :deps
 {org.clojure/clojure               {:mvn/version "1.12.6"}
  ;; the libraries Groundwork is cut into (libs/), one by one
  io.github.p4ulcristian/ground-wire {:local/root "libs/ground-wire"}
  com.github.seancorfield/next.jdbc {:mvn/version "1.4.70"}
  org.postgresql/postgresql         {:mvn/version "42.7.14"}
  com.zaxxer/HikariCP               {:mvn/version "7.1.0"}
  metosin/jsonista                  {:mvn/version "1.0.2"}
  integrant/integrant               {:mvn/version "1.0.1"}
  http-kit/http-kit                 {:mvn/version "2.8.1"}
  metosin/reitit-ring               {:mvn/version "0.11.0"}
  ;; loaded by our own code (reitit.core, ring.util.codec), so named here, not
  ;; left to come in through reitit-ring and ring-core
  metosin/reitit-core               {:mvn/version "0.11.0"}
  ring/ring-core                    {:mvn/version "1.15.6"}
  ring/ring-codec                   {:mvn/version "1.3.0"}
  metosin/malli                     {:mvn/version "0.20.3"}
  ;; the browser half (ClojureScript only)
  re-frame/re-frame                 {:mvn/version "1.4.7"}
  reagent/reagent                   {:mvn/version "2.0.1"}
  metosin/reitit-frontend           {:mvn/version "0.11.0"}}

 :aliases
 {;; npm install && npx shadow-cljs compile test   (the browser half's tests, on node)
  :cljs {:extra-paths ["test" "libs/ground-wire/test"]
         :extra-deps  {thheller/shadow-cljs {:mvn/version "3.5.7"}}}

  ;; clojure -X:test   (local database groundwork_test, see test/groundwork/postgres_test.clj)
  :test {:extra-paths ["test"]
         :extra-deps  {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                       ;; HikariCP logs through SLF4J; the app picks a logger, tests pick none
                       org.slf4j/slf4j-nop {:mvn/version "2.0.20"}
                       ;; groundwork.permissions.leaks generates params
                       org.clojure/test.check {:mvn/version "1.1.3"}
                       ;; groundwork.repl.dev, the development start
                       nrepl/nrepl {:mvn/version "1.8.0"}
                       ;; groundwork.build, compiling the example app in build-test
                       thheller/shadow-cljs {:mvn/version "3.5.7"}}
         :exec-fn     cognitect.test-runner.api/test}}}
