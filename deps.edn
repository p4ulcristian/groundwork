;; groundwork: one tree. source-code/groundwork/server/<library>/ runs on the server
;; (groundwork.server.*), source-code/groundwork/browser/<library>/ in the browser
;; (groundwork.browser.*). Which library may use which is libraries.edn, checked by
;; test-code/groundwork/libraries_test.clj.
{:paths ["source-code"]

 :deps
 {org.clojure/clojure               {:mvn/version "1.12.6"}
  ;; groundwork-shaped-json: its own library, github.com/p4ulcristian/groundwork-shaped-json; main makes the app's
  ;; one shaper from the :shaped-json settings and passes it to every library
  io.github.p4ulcristian/groundwork-shaped-json       {:git/tag "v0.2.2" :git/sha "1c0fcf9"}
  ;; the settings and the browser start's options, checked by their shapes
  metosin/malli                     {:mvn/version "0.20.3"}
  ;; groundwork-logs: the app's log, its own library, github.com/p4ulcristian/groundwork-logs;
  ;; main makes one logger from the :logs settings and passes its log to every library
  io.github.p4ulcristian/groundwork-logs    {:git/tag "v0.1.3" :git/sha "8d1846e"}
  ;; groundwork-postgres: Postgres, its own library, github.com/p4ulcristian/groundwork-postgres
  ;; on its tidy-up branch, not released: a table map writes out :uniques and :checks, a
  ;; reference what it does, an index as a map; migrate! takes {:tables :extensions :functions
  ;; :views}, a function a file or one a library made, and drops a function in the tables'
  ;; folders that nothing declared makes; a column's type changed by a change; run-after-commit!;
  ;; run-in-transaction! takes the caller's :log, where an after-commit failure is written
  io.github.p4ulcristian/groundwork-postgres     {:git/tag "v0.4.10" :git/sha "0956bdc"}
  ;; groundwork-background-jobs: background jobs on Postgres, its own library, github.com/p4ulcristian/groundwork-background-jobs
  ;; on its tidy-up branch, not released: a job kind names its system actor, and its one
  ;; transaction (the work and the done-mark) runs as it, opened by groundwork-access's run-as-system!,
  ;; carrying the job's log; its tables in groundwork-postgres's tidy-up shapes
  io.github.p4ulcristian/groundwork-background-jobs   {:git/tag "v0.5.10" :git/sha "daefd57"}
  ;; groundwork-steps: a handler's steps over one context, and the answer's shape (the
  ;; refusal, the reasons every answer may carry), which groundwork-bridge, groundwork-access,
  ;; groundwork-live-updates and groundwork-screens share instead of requiring each other;
  ;; both sides, its own library, github.com/p4ulcristian/groundwork-steps
  io.github.p4ulcristian/groundwork-steps    {:git/tag "v0.1.0" :git/sha "ed9458e"}
  ;; bridge: named messages over http, sse and ws, the lines, the rate limits, the server and
  ;; its routes; it runs a handler's groundwork-steps; both sides, its own library,
  ;; github.com/p4ulcristian/groundwork-bridge (it brings Jetty 12 through rj9a and reitit-ring).
  ;; groundwork plugs it in: its runner answers groundwork-access's steps, its sse lines carry
  ;; groundwork-live-updates's changes, its send-message! is groundwork-screens's send
  io.github.p4ulcristian/groundwork-bridge   {:git/tag "v0.7.12" :git/sha "f61608b"}
  ;; groundwork-access: who is asking and what may they do, sessions and access, its own
  ;; library, github.com/p4ulcristian/groundwork-access (it brings malli and test.check); its
  ;; steps are groundwork-steps's, and its leak test is handed a runner
  ;; (make-leak-test-answerer: groundwork-bridge's answer-message)
  io.github.p4ulcristian/groundwork-access    {:git/tag "v0.7.15" :git/sha "e70edfe"}
  ;; groundwork-live-updates: a change to a table rings every open screen, which asks again;
  ;; both sides, its own library, github.com/p4ulcristian/groundwork-live-updates; it is
  ;; handed how a line is told (:push!, groundwork-bridge's sse send) and told apart
  ;; (:find-line-key, the line's :groundwork-bridge/channel)
  io.github.p4ulcristian/groundwork-live-updates   {:git/tag "v0.5.14" :git/sha "9c29bbe"}
  ;; groundwork-screens: the browser's screens over groundwork-live-updates's question store, in re-frame,
  ;; drawn with Reagent in groundwork-screens.views (it brings re-frame, Reagent and reitit-frontend;
  ;; react and react-dom are package.json's), and the address bar it follows; the browser's
  ;; side only, its own library, github.com/p4ulcristian/groundwork-screens; its sends are
  ;; handed in (groundwork-bridge's send-message!)
  io.github.p4ulcristian/groundwork-screens     {:git/tag "v0.8.9" :git/sha "91a1dbe"}
  ;; groundwork-languages: which language a request, a page and an address are in; both
  ;; sides, its own library, github.com/p4ulcristian/groundwork-languages (groundwork-screens brings
  ;; it to the browser too)
  ;; on its tidy-up branch, not released: with-language refuses a nil language or bad texts;
  ;; check-texts-of-reasons; tr is the one text call on the server
  io.github.p4ulcristian/groundwork-languages {:git/tag "v0.4.3" :git/sha "75b7b30"}
  ;; groundwork-metrics: the app's metrics, its own library, github.com/p4ulcristian/groundwork-metrics;
  ;; main makes one meter from the :meter settings and passes it to every
  ;; library that counts, and serves its text at the :metrics route
  io.github.p4ulcristian/groundwork-metrics      {:git/tag "v0.1.7" :git/sha "53c7099"}
  ;; groundwork-file-storage: the app's files, its own library, github.com/p4ulcristian/groundwork-file-storage;
  ;; main makes one file storage from the :file-storage :storage settings, migrates its files
  ;; table and serves its upload route at :file-storage :upload :path
  ;; on its tidy-up branch, not released: its files table in groundwork-postgres's tidy-up shapes;
  ;; delete-file-after-commit!, by groundwork-postgres's run-after-commit!
  io.github.p4ulcristian/groundwork-file-storage     {:git/tag "v0.1.8" :git/sha "79f044a"}
  ;; groundwork-email: the app's email, its own library, github.com/p4ulcristian/groundwork-email;
  ;; main makes one mailer from the :email :sending settings, runs its
  ;; background job kind, migrates its emails table and serves its webhooks
  ;; on its tidy-up branch, not released: the sending job runs as the :system-actor the app names;
  ;; its emails table in groundwork-postgres's tidy-up shapes
  io.github.p4ulcristian/groundwork-email   {:git/tag "v0.1.8" :git/sha "c30d4d7"}
  ;; groundwork-settings: the settings and their secrets, its own library, github.com/p4ulcristian/groundwork-settings;
  ;; an app loads its settings with settings/load, every secret in them wrapped (it prints
  ;; as its name); groundwork compares the :errors token with settings/equal?
  io.github.p4ulcristian/groundwork-settings       {:git/tag "v0.1.4" :git/sha "f235cc4"}
  ;; groundwork-live-repl: the REPL into the running app, by the :live-repl settings, with
  ;; groundwork's tools in groundwork-live-repl.tools; its own library, github.com/p4ulcristian/groundwork-live-repl
  io.github.p4ulcristian/groundwork-live-repl      {:git/tag "v0.1.3" :git/sha "db5bd86"}}

 :aliases
 {;; every test:                  clojure -X:test
  ;; one library's tests:         clojure -X:test :dirs '["test-code/groundwork/server/main"]'
  :test {:extra-paths ["test-code"]
         :extra-deps  {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                       ;; the browser build's test compiles every browser library, and the
                       ;; end-to-end test release-builds its sample app
                       io.github.p4ulcristian/groundwork-browser-build {:git/tag "v0.4.5" :git/sha "268e20f"}}
         :exec-fn     cognitect.test-runner.api/test
         :exec-args   {:dirs ["test-code"]}}

  ;; the browser build: browser-build, its own library, github.com/p4ulcristian/groundwork-browser-build
  ;; (it brings shadow-cljs); on its tidy-up branch, not released: a module names its
  ;; :start, a build its :silenced-warnings, :css (its :targets; the lightningcss program is
  ;; browser-build's pin) and :lightningcss-download-timeout-ms, a watch its :preloads.
  ;; Only to build, never in production: it is in these
  ;; aliases, not in :deps. Development: add :browser-build to the REPL or the dev start
  ;; (its watch options are the :browser-build {:watch …} settings).
  ;; The deploy:  clojure -X:browser-release (an app writes its own :entry and :files-folder)
  :browser-build   {:extra-deps {io.github.p4ulcristian/groundwork-browser-build {:git/tag "v0.4.5" :git/sha "268e20f"}}}
  :browser-release {:extra-deps {io.github.p4ulcristian/groundwork-browser-build {:git/tag "v0.4.5" :git/sha "268e20f"}}
                    :exec-fn    groundwork-browser-build.api/build-for-release!
                    :exec-args  {:entry              app.browser.main/start!
                                 :modules            {}               ; the app's :browser-modules, loaded on demand, each with its :start
                                 :files-folder       "target/public"
                                 :cache-folder       ".shadow-cljs"   ; shadow-cljs's cache
                                 :compile-threads    4
                                 :output-feature-set :es2020          ; what the browsers must understand
                                 :resolve            {}
                                 :closure-defines    {}
                                 :warnings-as-errors #{}
                                 :silenced-warnings  #{}              ; compiler warnings not shown
                                 :css                nil              ; no CSS step: each bundle as its files are written; or {:targets "chrome >= 119, safari >= 16.4"}
                                 :lightningcss-download-timeout-ms 60000   ; browser-build's pinned lightningcss, downloaded with :css
                                 :source-maps?       false            ; a .map beside each file, readable by anyone
                                 :gzip-level         9}}}}            ; the .gz copies, 1 (fast) to 9 (smallest)
