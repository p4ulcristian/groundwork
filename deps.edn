;; house: one tree. source-code/house/server/<library>/ runs on the server
;; (house.server.*), source-code/house/browser/<library>/ in the browser
;; (house.browser.*). Which library may use which is libraries.edn, checked by
;; test-code/house/libraries_test.clj.
{:paths ["source-code"]

 :deps
 {org.clojure/clojure               {:mvn/version "1.12.6"}
  ;; wire: its own library, github.com/p4ulcristian/wire; main makes the app's
  ;; one wire from the :wire settings and passes it to every library
  io.github.p4ulcristian/wire       {:git/tag "v0.2.0" :git/sha "d66b7cb"}
  ;; the settings and the browser start's options, checked by their shapes
  metosin/malli                     {:mvn/version "0.20.3"}
  ;; logbook: the app's log, its own library, github.com/p4ulcristian/logbook;
  ;; main makes one logbook from the :logbook settings and passes its log to every library
  io.github.p4ulcristian/logbook    {:git/tag "v0.1.1" :git/sha "51a2c93"}
  ;; cellar: Postgres, its own library, github.com/p4ulcristian/cellar
  io.github.p4ulcristian/cellar     {:git/tag "v0.4.1" :git/sha "4d86120"}
  ;; backroom: background jobs on Postgres, its own library, github.com/p4ulcristian/backroom
  io.github.p4ulcristian/backroom   {:git/tag "v0.5.1" :git/sha "b2858dd"}
  ;; mailroom: named messages over http, sse and ws, a handler's steps, the routes;
  ;; both sides, its own library, github.com/p4ulcristian/mailroom (it brings
  ;; http-kit, reitit-ring and reitit-frontend)
  io.github.p4ulcristian/mailroom   {:git/tag "v0.7.1" :git/sha "0d67929"}
  ;; doorman: who is asking and what may they do, sessions and access, its own
  ;; library, github.com/p4ulcristian/doorman (it brings malli and test.check)
  io.github.p4ulcristian/doorman    {:git/tag "v0.7.1" :git/sha "61dd604"}
  ;; doorbell: a change to a table rings every open screen, which asks again;
  ;; both sides, its own library, github.com/p4ulcristian/doorbell
  io.github.p4ulcristian/doorbell   {:git/tag "v0.5.1" :git/sha "2dba050"}
  ;; parlor: the browser's screens over doorbell's question store, in re-frame,
  ;; drawn with Reagent (it brings re-frame and Reagent; react and react-dom
  ;; are package.json's); the browser's side only, its own library,
  ;; github.com/p4ulcristian/parlor
  io.github.p4ulcristian/parlor     {:git/tag "v0.7.1" :git/sha "61c985a"}
  ;; dictionary: which language a request, a page and an address are in; both
  ;; sides, its own library, github.com/p4ulcristian/dictionary (parlor brings
  ;; it to the browser too)
  io.github.p4ulcristian/dictionary {:git/tag "v0.2.0" :git/sha "df1d373"}
  ;; meter: the app's metrics, its own library, github.com/p4ulcristian/meter;
  ;; main makes one meter from the :meter settings and passes it to every
  ;; library that counts, and serves its text at the :metrics route
  io.github.p4ulcristian/meter      {:git/tag "v0.1.2" :git/sha "a0a977b"}
  ;; study: the REPL into the running app, by the :study settings, with
  ;; house's tools in study.tools; its own library, github.com/p4ulcristian/study
  io.github.p4ulcristian/study      {:git/tag "v0.1.1" :git/sha "d8ba537"}}

 :aliases
 {;; every test:                  clojure -X:test
  ;; one library's tests:         clojure -X:test :dirs '["test-code/house/server/main"]'
  :test {:extra-paths ["test-code"]
         :extra-deps  {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                       ;; the browser build's test compiles every browser library, and the
                       ;; end-to-end test release-builds its sample app
                       io.github.p4ulcristian/showroom {:git/tag "v0.4.1" :git/sha "ac1139d"}}
         :exec-fn     cognitect.test-runner.api/test
         :exec-args   {:dirs ["test-code"]}}

  ;; the browser build: showroom, its own library, github.com/p4ulcristian/showroom
  ;; (it brings shadow-cljs). Only to build, never in production: it is in these
  ;; aliases, not in :deps. Development: add :browser-build to the REPL or the dev start
  ;; (its watch options are the :browser-build {:watch …} settings).
  ;; The deploy:  clojure -X:browser-release (an app writes its own :entry and :files-folder)
  :browser-build   {:extra-deps {io.github.p4ulcristian/showroom {:git/tag "v0.4.1" :git/sha "ac1139d"}}}
  :browser-release {:extra-deps {io.github.p4ulcristian/showroom {:git/tag "v0.4.1" :git/sha "ac1139d"}}
                    :exec-fn    showroom.api/build-for-release!
                    :exec-args  {:entry              app.browser.main/start!
                                 :modules            {}               ; the app's :browser-modules, loaded on demand
                                 :files-folder       "target/public"
                                 :cache-folder       ".shadow-cljs"   ; shadow-cljs's cache
                                 :compile-threads    4
                                 :output-feature-set :es2020          ; what the browsers must understand
                                 :source-maps?       false            ; a .map beside each file, readable by anyone
                                 :gzip-level         9}}}}            ; the .gz copies, 1 (fast) to 9 (smallest)
