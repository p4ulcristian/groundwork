{;; Groundwork: one source tree; each library is a folder in
 ;; source-code/groundwork/ (libraries.edn says which may use which).
 :paths ["source-code"]

 :deps
 {org.clojure/clojure {:mvn/version "1.12.6"}
  ;; groundwork.wire
  metosin/malli       {:mvn/version "0.20.3"}
  metosin/jsonista    {:mvn/version "1.0.2"}}

 :aliases
 {;; npm install && npx shadow-cljs compile test   (the browser half's tests, on node)
  :cljs {:extra-paths ["test"]
         :extra-deps  {thheller/shadow-cljs {:mvn/version "3.5.7"}}}

  ;; clojure -X:test
  :test {:extra-paths ["test"]
         :extra-deps  {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :exec-fn     cognitect.test-runner.api/test}}}
