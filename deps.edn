{;; Groundwork: its libraries live in libraries/; groundwork.main puts them
 ;; together, so depending on this repo is depending on groundwork.main.
 :deps
 {io.github.p4ulcristian/groundwork-main {:local/root "libraries/main"}}

 :aliases
 {;; npm install && npx shadow-cljs compile test   (the browser half's tests, on node)
  :cljs {:extra-paths ["test" "libraries/wire/test"]
         :extra-deps  {thheller/shadow-cljs {:mvn/version "3.5.7"}}}

  ;; clojure -X:test   (local database groundwork_test, see test/groundwork/postgres_test.clj)
  :test {:extra-paths ["test"]
         :extra-deps  {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                       ;; HikariCP logs through SLF4J; the app picks a logger, tests pick none
                       org.slf4j/slf4j-nop {:mvn/version "2.0.20"}
                       ;; groundwork.permissions.leaks generates params
                       org.clojure/test.check {:mvn/version "1.1.3"}
                       ;; groundwork.repl.dev, the development start
                       nrepl/nrepl {:mvn/version "1.8.0"}
                       ;; groundwork.build, compiling the example app in build-test
                       thheller/shadow-cljs {:mvn/version "3.5.7"}}
         :exec-fn     cognitect.test-runner.api/test}}}
