;; Groundwork: one tree. source-code/groundwork/server/<library>/ runs on the server
;; (groundwork.server.*), source-code/groundwork/browser/<library>/ in the browser
;; (groundwork.browser.*). Which library may use which is libraries.edn, checked by
;; test-code/groundwork/libraries_test.clj.
{:paths ["source-code"]

 :deps
 {org.clojure/clojure               {:mvn/version "1.12.6"}
  ;; wire: its own library, github.com/p4ulcristian/wire
  io.github.p4ulcristian/wire       {:git/tag "v0.1.2" :git/sha "1e8e9aa"}
  ;; cellar: Postgres, its own library, github.com/p4ulcristian/cellar
  io.github.p4ulcristian/cellar     {:git/tag "v0.1.1" :git/sha "1354d94"}
  ;; backroom: background jobs on Postgres, its own library, github.com/p4ulcristian/backroom
  io.github.p4ulcristian/backroom   {:git/tag "v0.1.0" :git/sha "3edc326"}
  ;; access's sentences and leak test, sync's change messages
  metosin/malli                     {:mvn/version "0.20.3"}
  metosin/jsonista                  {:mvn/version "1.0.2"}
  ;; transport
  http-kit/http-kit                 {:mvn/version "2.8.1"}
  metosin/reitit-ring               {:mvn/version "0.11.0"}
  ;; the browser's transport: ClojureScript sources, compiled into the app's JS
  metosin/reitit-frontend           {:mvn/version "0.11.0"}
  ;; access's leak test: malli's generator
  org.clojure/test.check            {:mvn/version "1.1.1"}}

 :aliases
 {;; every test:                  clojure -X:test
  ;; one library's tests:         clojure -X:test :dirs '["test-code/groundwork/server/sessions"]'
  :test {:extra-paths ["test-code"]
         :extra-deps  {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                       ;; HikariCP (in cellar) logs through SLF4J; tests pick no logger
                       org.slf4j/slf4j-nop {:mvn/version "2.0.17"}
                       ;; the browser build's test compiles every browser library
                       io.github.p4ulcristian/showroom {:git/tag "v0.1.0" :git/sha "36a51a9"}}
         :exec-fn     cognitect.test-runner.api/test
         :exec-args   {:dirs ["test-code"]}}

  ;; the browser build: showroom, its own library, github.com/p4ulcristian/showroom
  ;; (it brings shadow-cljs). Only to build, never in production: it is in these
  ;; aliases, not in :deps. Development: add :browser-build to the REPL or the dev start.
  ;; The deploy:  clojure -X:browser-release :entry app.browser.main/start! :files-folder '"target/public"'
  :browser-build   {:extra-deps {io.github.p4ulcristian/showroom {:git/tag "v0.1.0" :git/sha "36a51a9"}}}
  :browser-release {:extra-deps {io.github.p4ulcristian/showroom {:git/tag "v0.1.0" :git/sha "36a51a9"}}
                    :exec-fn    showroom.api/build-for-release!}}}
