#!/usr/bin/env bash
# bump <library> [<library> ...]
#
# Releases the named manor libraries and carries their new tags through
# everything that uses them, in order, house last:
#   1. each named library: next patch tag on its main, pushed; README take-line
#   2. every manor library that names a bumped one in its deps.edn: pinned to
#      the new tag, committed, pushed, then released the same way (cascade)
#   3. house: pinned to every new tag, committed and pushed on its branch
# No tests are run. The libraries sit beside house, in the manor folder.
set -euo pipefail
manor="$(cd "$(dirname "$0")/../.." && pwd)"
coauthor="Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>"

pin() { # pin LIB TAG SHA FILE
  sed -i -E "s|(io\.github\.p4ulcristian/$1 +\{:git/tag \")[^\"]+(\" :git/sha \")[0-9a-f…]+\"|\1$2\2$3\"|g" "$4"
}

users_of() { # libraries (not house) whose deps.edn names LIB
  for d in "$manor"/*/; do
    r=$(basename "$d")
    [ "$r" = house ] || [ "$r" = "$1" ] && continue
    grep -qE "p4ulcristian/$1 +\{:git/tag" "$d/deps.edn" 2>/dev/null && echo "$r"
  done
}

declare -A new_tag new_sha
release() { # release LIB: pull, tag next patch, take-line
  local r=$1 dir="$manor/$1" old new sha
  git -C "$dir" pull -q --ff-only
  old=$(git -C "$dir" describe --tags --abbrev=0)
  new=$(echo "$old" | awk -F. '{print $1"."$2"."$3+1}')
  git -C "$dir" tag "$new"; git -C "$dir" push -q origin "$new"
  sha=$(git -C "$dir" rev-parse --short=7 HEAD)
  pin "$r" "$new" "$sha" "$dir/README.md"
  if ! git -C "$dir" diff --quiet; then
    git -C "$dir" commit -qam "README: take $new" -m "$coauthor"; git -C "$dir" push -q
  fi
  new_tag[$r]=$new; new_sha[$r]=$sha
  echo "  $r $old -> $new ($sha)"
}

take() { # take DIR: pin every new tag in DIR/deps.edn, commit, push
  local dir=$1
  # called as `take … || …`, where set -e is off: every step stops the run itself
  git -C "$dir" pull -q --ff-only || { echo "bump: pulling $dir failed" >&2; exit 1; }
  for l in "${!new_tag[@]}"; do pin "$l" "${new_tag[$l]}" "${new_sha[$l]}" "$dir/deps.edn"; done
  if ! git -C "$dir" diff --quiet; then
    git -C "$dir" commit -qam "Take the newest manor libraries" -m "$coauthor" \
      || { echo "bump: committing in $dir failed" >&2; exit 1; }
    git -C "$dir" push -q || { echo "bump: pushing $dir failed" >&2; exit 1; }
    return 0
  fi
  return 1
}

[ $# -gt 0 ] || { sed -n '2,12p' "$0"; exit 1; }
queue=("$@"); done_list=" "
echo "Releasing:"
while [ ${#queue[@]} -gt 0 ]; do
  lib=${queue[0]}; queue=("${queue[@]:1}")
  case "$done_list" in *" $lib "*) continue;; esac
  # a library waits until everything it uses that is still queued is released
  wait=0
  for q in "${queue[@]}"; do
    grep -qE "p4ulcristian/$q +\{:git/tag" "$manor/$lib/deps.edn" 2>/dev/null && wait=1
  done
  if [ $wait = 1 ]; then queue+=("$lib"); continue; fi
  take "$manor/$lib" || true
  release "$lib"; done_list+="$lib "
  for u in $(users_of "$lib"); do queue+=("$u"); done
done
echo "house:"
take "$manor/house" && echo "  pinned and pushed ($(git -C "$manor/house" rev-parse --short HEAD))" || echo "  nothing to pin"
