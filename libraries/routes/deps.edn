;; groundwork.routes: pages by name, and the one Ring handler, with reitit;
;; uses no other library; its tests use groundwork.transport.
;; Its tests, here, see nothing else:   clojure -X:test
{:paths ["source-code"]

 :deps
 {org.clojure/clojure                         {:mvn/version "1.12.6"}
  metosin/reitit-ring                         {:mvn/version "0.11.0"}
  metosin/reitit-frontend                     {:mvn/version "0.11.0"}}

 :aliases
 {:test {:extra-paths ["test-code"]
         :extra-deps  {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                       ;; the tests serve pages next to transport's addresses
                       io.github.p4ulcristian/groundwork-transport {:local/root "../transport"}}
         :exec-fn     cognitect.test-runner.api/test
         :exec-args   {:dirs ["test-code"]}}}}
