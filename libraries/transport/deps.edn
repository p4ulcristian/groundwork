;; groundwork.transport: the server, and http, sse and ws over it; uses groundwork.steps and groundwork.wire.
;; Its tests, here, see nothing else:   clojure -X:test
{:paths ["source-code"]

 :deps
 {org.clojure/clojure                     {:mvn/version "1.12.6"}
  http-kit/http-kit                       {:mvn/version "2.8.1"}
  io.github.p4ulcristian/groundwork-steps {:local/root "../steps"}
  io.github.p4ulcristian/groundwork-wire  {:local/root "../wire"}}

 :aliases
 {:test {:extra-paths ["test-code"]
         :extra-deps  {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :exec-fn     cognitect.test-runner.api/test
         :exec-args   {:dirs ["test-code"]}}}}
