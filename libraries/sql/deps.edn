;; groundwork.sql: Postgres through next.jdbc, PgJDBC and a HikariCP pool.
;; Its tests, here, see nothing else:   clojure -X:test
;; The tests that need Postgres run when GROUNDWORK_SQL_TEST_PORT is set.
{:paths ["source-code"]

 :deps
 {org.clojure/clojure               {:mvn/version "1.12.6"}
  com.github.seancorfield/next.jdbc {:mvn/version "1.4.70"}
  org.postgresql/postgresql         {:mvn/version "42.7.14"}
  com.zaxxer/HikariCP               {:mvn/version "7.1.0"}
  metosin/jsonista                  {:mvn/version "1.0.2"}}

 :aliases
 {:test {:extra-paths ["test-code"]
         :extra-deps  {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                       ;; HikariCP logs through SLF4J; tests pick no logger
                       org.slf4j/slf4j-nop {:mvn/version "2.0.17"}}
         :exec-fn     cognitect.test-runner.api/test
         :exec-args   {:dirs ["test-code"]}}}}
