;; groundwork.sessions: who is asking; a session in Postgres, a cookie in the browser.
;; Uses groundwork.server.database and groundwork.server.steps.
;; Its tests, here, see nothing else:   clojure -X:test
;; The tests that need Postgres run when GROUNDWORK_SQL_TEST_PORT is set.
{:paths ["source-code"]

 :deps
 {org.clojure/clojure                        {:mvn/version "1.12.6"}
  io.github.p4ulcristian/groundwork-server-database {:local/root "../database"}
  io.github.p4ulcristian/groundwork-server-steps    {:local/root "../steps"}}

 :aliases
 {:test {:extra-paths ["test-code"]
         :extra-deps  {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                       org.slf4j/slf4j-nop {:mvn/version "2.0.17"}}
         :exec-fn     cognitect.test-runner.api/test
         :exec-args   {:dirs ["test-code"]}}}}
