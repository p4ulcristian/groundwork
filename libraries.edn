;; Groundwork's libraries, by side, and which others each may use.
;; test-code/groundwork/libraries_test.clj checks every namespace against it:
;; a library requires only the libraries it lists, and only their api;
;; nobody uses another around a circle.
{:server  {:wire            #{}
           :steps           #{}
           :database        #{}
           :transport       #{:steps :wire}
           :sessions        #{:database :steps}
           :access          #{:database :steps :wire :transport}
           :background-jobs #{:database :wire}
           :sync            #{:database :transport :access :steps :wire}
           ;; main loads browser-build only when it watches (requiring-resolve):
           ;; production has no shadow-cljs
           :browser-build   #{}
           :main            #{:wire :steps :database :transport :sessions :access :background-jobs :sync :browser-build}}
 :browser {:wire      #{}
           :transport #{:wire}
           :sync      #{}
           :styles    #{}
           :main      #{:wire :transport :sync}}}
