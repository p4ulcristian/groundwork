;; a library requires only the libraries it lists, and only their api;
;; nobody uses another around a circle.
{:server  {:wire              #{}
           :steps             #{}
           :database          #{}
           :transport         #{:steps :wire}
           :sessions          #{:database :steps}
           :access            #{:database :steps :wire :transport}
           :background-chores #{:database :wire}
           :main              #{:wire :steps :database :transport :sessions :access :background-chores}}
 :browser {:wire      #{}
           :transport #{:wire}
           :main      #{:wire :transport}}}
